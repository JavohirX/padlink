<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/controller_background">

    <!-- Main controller layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controllerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Vertical center guideline (50%) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- D-Pad: left side, centered vertically -->
        <com.segacontroller.DPadView
            android:id="@+id/dpadView"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.55"
            android:layout_marginStart="32dp" />

        <!-- ===== RIGHT SIDE BUTTONS ===== -->

        <!-- Z button: top row, leftmost -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnZ"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnY"
            app:layout_constraintVertical_bias="0.22"
            app:layout_constraintBottom_toTopOf="@+id/btnA"
            android:layout_marginEnd="8dp" />

        <!-- Y button: top row, center -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnY"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@+id/btnZ"
            app:layout_constraintBottom_toBottomOf="@+id/btnZ"
            app:layout_constraintEnd_toStartOf="@+id/btnX"
            android:layout_marginEnd="8dp" />

        <!-- X button: top row, rightmost -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnX"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@+id/btnZ"
            app:layout_constraintBottom_toBottomOf="@+id/btnZ"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="32dp" />

        <!-- A button: bottom row, leftmost (below Z) -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnA"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.65"
            app:layout_constraintEnd_toStartOf="@+id/btnB"
            android:layout_marginEnd="10dp" />

        <!-- B button: bottom row, center (below Y) -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnB"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:layout_constraintTop_toTopOf="@+id/btnA"
            app:layout_constraintBottom_toBottomOf="@+id/btnA"
            app:layout_constraintEnd_toStartOf="@+id/btnC"
            android:layout_marginEnd="10dp" />

        <!-- C button: bottom row, rightmost (below X) -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnC"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:layout_constraintTop_toTopOf="@+id/btnA"
            app:layout_constraintBottom_toBottomOf="@+id/btnA"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="32dp" />

        <!-- Turbo A (small, above A) -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnTA"
            android:layout_width="60dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toTopOf="@+id/btnA"
            app:layout_constraintStart_toStartOf="@+id/btnA"
            app:layout_constraintEnd_toEndOf="@+id/btnA"
            android:layout_marginBottom="6dp" />

        <!-- Turbo C (small, above C) -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnTC"
            android:layout_width="60dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toTopOf="@+id/btnC"
            app:layout_constraintStart_toStartOf="@+id/btnC"
            app:layout_constraintEnd_toEndOf="@+id/btnC"
            android:layout_marginBottom="6dp" />

        <!-- Start button: bottom center, right of guideline -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnStart"
            android:layout_width="90dp"
            android:layout_height="36dp"
            app:layout_constraintStart_toStartOf="@+id/guidelineCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Mode button: bottom center, left of guideline -->
        <com.segacontroller.ButtonView
            android:id="@+id/btnMode"
            android:layout_width="80dp"
            android:layout_height="36dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Role indicator: top-center small text -->
        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineCenter"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp" />

        <!-- Settings/Haptic toggle: top-left small -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="V"
            android:textSize="10sp"
            android:padding="0dp"
            android:backgroundTint="@color/button_settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Reconnecting banner overlay -->
    <LinearLayout
        android:id="@+id/bannerReconnecting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/banner_background"
        android:padding="8dp"
        android:layout_gravity="top"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReconnecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reconnecting"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
